# Porta onde o servidor Node vai rodar
PORT=3000

# A sua URI do MongoDB Atlas (Substitua pelos seus dados reais)
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<seu-cluster>.mongodb.net/competicao_leitura?retryWrites=true&w=majority

# Chave secreta para gerar tokens de autenticação (pode ser qualquer texto longo)
JWT_SECRET=minha_chave_secreta_super_segura_mvp_123

# Chave oficial da API do Google Books (Gerada no Google Cloud Console)
GOOGLE_BOOKS_API_KEY=cole_aqui_a_sua_api_key_do_google_books
